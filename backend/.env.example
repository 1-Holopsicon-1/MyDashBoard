# Tailscale API key (from https://login.tailscale.com/admin/settings/keys)
TAILSCALE_API_KEY=tskey-api-xxxxx

# Tailscale tailnet ID
TAILSCALE_TAILNET=

# Vaultwarden URL for health check
VAULTWARDEN_URL=http://localhost:8080

# Docker socket path
DOCKER_SOCKET=/var/run/docker.sock

# Container name filters (comma-separated)
CONTAINER_FILTERS=

# Session secret (auto-generated if empty)
SESSION_SECRET=

# WebAuthn config (localhost for local dev)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# SQLite database path
DB_PATH=dashboard.db

# Listen address
LISTEN_ADDR=:8081
