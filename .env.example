# Dashboard backend configuration

# Server
LISTEN_ADDR=:8081

# Tailscale
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# Services
VAULTWARDEN_URL=

# Docker
DOCKER_SOCKET=/var/run/docker.sock
CONTAINER_FILTERS=amnezia,simplex

# Auth
SESSION_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
DB_PATH=dashboard.db
