# Dashboard configuration (Docker deployment)
# Copy to .env and fill with your values.
# For local development, use backend/.env.example instead.

# Server
LISTEN_ADDR=:8081

# Tailscale
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# Services
VAULTWARDEN_URL=

# Docker
DOCKER_SOCKET=/var/run/docker.sock
CONTAINER_FILTERS=amnezia,simplex

# Auth
# SESSION_SECRET: required in production (when WEBAUTHN_RP_ID != localhost).
# Auto-generated in dev mode, but sessions will not survive restart.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# WebAuthn config
# Override for production: set to your domain and origin URL.
# CORS allowed origin is automatically derived from WEBAUTHN_ORIGIN.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# SQLite database path
# For Docker deployment: DB_PATH=/app/data/dashboard.db
DB_PATH=dashboard.db